{
  "entities": {
    "settings": {
      "title": "Settings",
      "description": "Application settings",
      "type": "object",
      "properties": {
        "tradingMode": { "type": "string" },
        "minNetEdgePercent": { "type": "number" },
        "maxTradeSizeUsd": { "type": "number" },
        "maxDailyLossUsd": { "type": "number" },
        "maxConcurrentTrades": { "type": "number" },
        "maxSlippagePercent": { "type": "number" },
        "maxDataAgeMs": { "type": "number" },
        "minLiquidityUsd": { "type": "number" },
        "killSwitchActive": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      }
    },
    "exchangeAccount": {
      "title": "Exchange Account",
      "description": "External exchange credentials",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "exchange": { "type": "string" },
        "apiKey": { "type": "string" },
        "apiSecret": { "type": "string" },
        "passphrase": { "type": "string" },
        "isActive": { "type": "boolean" },
        "status": { "type": "string" }
      }
    },
    "balance": {
      "title": "Balance",
      "description": "Asset balance info",
      "type": "object",
      "properties": {
        "asset": { "type": "string" },
        "exchange": { "type": "string" },
        "free": { "type": "number" },
        "locked": { "type": "number" },
        "total": { "type": "number" },
        "usdValue": { "type": "number" },
        "mode": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/settings/risk": {
      "schema": "settings",
      "description": "Global risk management settings"
    },
    "/exchangeAccounts/{accountId}": {
      "schema": "exchangeAccount",
      "description": "User exchange accounts"
    },
    "/balances/{balanceId}": {
      "schema": "balance",
      "description": "Cached balances"
    }
  }
}
